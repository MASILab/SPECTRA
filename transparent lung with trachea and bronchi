import nibabel as nib
import numpy as np
from skimage import measure
import pyvista as pv
import os

os.makedirs("output", exist_ok=True)

lung_img = nib.load("data/segmentation_file.nii.gz")
lung_data = lung_img.get_fdata()
lung_affine = lung_img.affine

print("Lung labels:", np.unique(lung_data))
print("Lung shape:", lung_data.shape)


airway_img = nib.load("data/output.nii.gz")
airway_data = airway_img.get_fdata()
airway_affine = airway_img.affine

print("Airway labels:", np.unique(airway_data))
print("Airway shape:", airway_data.shape)


structures = {
    10: "Left Upper",
    11: "Left Lower",
    12: "Right Upper",
    13: "Right Middle",
    14: "Right Lower",
}

airway_structures = {
    1: "Airways",
    2: "Airway Wall",
}


label_colors = {

    # Lungs
    10: [255, 182, 193],
    11: [255, 105, 180],
    12: [156, 229, 247],
    13: [84, 170, 235],
    14: [37, 106, 204],

    # Airways
    1: [0, 76, 153],
    2: [0, 76, 153],
}


multiblock = pv.MultiBlock()


def create_mesh(data, label, color, affine):

    mask = (data == label).astype(np.uint8)

    if np.sum(mask) == 0:
        return None

    print(
        f"Creating mesh for label {label}, voxels:",
        np.sum(mask)
    )

    verts, faces, _, _ = measure.marching_cubes(
        mask,
        level=0.5
    )

    verts = nib.affines.apply_affine(
        affine,
        verts
    )

    faces_pv = np.hstack([
        np.full(
            (faces.shape[0], 1),
            3
        ),
        faces
    ]).astype(np.int64)


    mesh = pv.PolyData(
        verts,
        faces_pv
    )


    mesh.cell_data["label"] = np.full(
        mesh.n_cells,
        label
    )


    rgb = np.array(
        color,
        dtype=np.uint8
    )

    mesh.cell_data["RGB"] = np.tile(
        rgb,
        (mesh.n_cells, 1)
    )


    return mesh



for label, name in structures.items():

    print(f"Processing {name}")

    mesh = create_mesh(
        lung_data,
        label,
        label_colors[label],
        lung_affine
    )

    if mesh is not None:
        multiblock[name] = mesh
    else:
        print(f"{name} empty")


for label, name in airway_structures.items():

    print(f"Processing {name}")

    mesh = create_mesh(
        airway_data,
        label,
        label_colors[label],
        airway_affine
    )

    if mesh is not None:
        multiblock[name] = mesh
    else:
        print(f"{name} empty")



output_file = "output/colored_lungs_airways.vtm"

multiblock.save(output_file)

print(f"Saved: {output_file}")



plotter = pv.Plotter()

plotter.background_color = "white"


for name in multiblock.keys():

    block = multiblock[name]

    if block is None:
        continue


    if name in [
        "Left Upper",
        "Left Lower",
        "Right Upper",
        "Right Middle",
        "Right Lower"
    ]:
        opacity = 0.25

    elif name == "Airways":
        opacity = 0

    else:
        opacity = 1.0


    plotter.add_mesh(
        block,
        scalars="RGB",
        rgb=True,
        opacity=opacity
    )


plotter.add_axes()

plotter.show()
