import json
import os

import numpy as np
import pyvista as pv
import SimpleITK as sitk


seg_file = "data/segmentation_file.nii.gz"
lut_file = "data/lut.json"

seg_labels_to_keep = (
    [10, 11, 12, 13, 14, 16]
    + list(range(32, 44))
    + list(range(92, 118))
)

bone_labels = set(range(32, 44)) | set(range(92, 118))


with open(lut_file, "r", encoding="utf-8") as f:
    lut = json.load(f)


def get_lut_entry(label):
    """Return and validate one label's name, RGB color, and opacity."""
    entry = lut.get(str(label))
    if entry is None:
        raise KeyError(f"Label {label} is missing from {lut_file}")

    rgb = entry.get("rgb")
    if (
        not isinstance(rgb, list)
        or len(rgb) != 3
        or any(not isinstance(value, (int, float)) for value in rgb)
        or any(value < 0 or value > 255 for value in rgb)
    ):
        raise ValueError(f"Label {label} has an invalid RGB value: {rgb!r}")

    opacity = float(entry.get("opacity", 1.0))
    if not 0.0 <= opacity <= 1.0:
        raise ValueError(f"Label {label} has invalid opacity: {opacity}")

    name = entry.get("structure", f"Label {label}")
    return name, np.asarray(rgb, dtype=np.uint8), opacity


def load_source(path, labels, source_name):
    image = sitk.ReadImage(path)
    array = sitk.GetArrayFromImage(image)
    direction = np.asarray(image.GetDirection(), dtype=float).reshape(3, 3)

    return {
        "name": source_name,
        "array": array,
        "labels": labels,
        "spacing": np.asarray(image.GetSpacing(), dtype=float),
        "origin": np.asarray(image.GetOrigin(), dtype=float),
        "direction": direction,
    }


sources = [
    load_source(seg_file, seg_labels_to_keep, "segmentation"),
]

meshes_by_label = {}

for source in sources:
    for label in source["labels"]:
        name, color, opacity = get_lut_entry(label)
        print(f'Processing {source["name"]} label {label}: {name}')

        mask_zyx = (source["array"] == label).astype(np.uint8)

        if mask_zyx.sum() == 0:
            print("  missing")
            continue

        mask_xyz = np.transpose(mask_zyx, (2, 1, 0))

        grid = pv.ImageData()
        grid.dimensions = np.asarray(mask_xyz.shape) + 1
        grid.spacing = source["spacing"]
        grid.origin = source["origin"]
        grid.direction_matrix = source["direction"]
        grid.cell_data["mask"] = mask_xyz.ravel(order="F")
        grid = grid.cell_data_to_point_data()

        surface = grid.contour(isosurfaces=[0.5], scalars="mask")

        if surface.n_points == 0:
            print("  empty surface")
            continue

        surface = surface.smooth(n_iter=200, relaxation_factor=0.05)
        surface.point_data["RGB"] = np.tile(color, (surface.n_points, 1))

        meshes_by_label[label] = {
            "name": name,
            "opacity": opacity,
            "mesh": surface,
        }

        print("  points:", surface.n_points)

if not meshes_by_label:
    raise RuntimeError("No meshes were generated. Check the input paths and labels.")

models = pv.MultiBlock()
for item in meshes_by_label.values():
    models.append(item["mesh"])

bounds = np.asarray(models.bounds)
center = np.array(
    [
        (bounds[0] + bounds[1]) / 2.0,
        (bounds[2] + bounds[3]) / 2.0,
        (bounds[4] + bounds[5]) / 2.0,
    ]
)

print("Scene center:", center)

directions = {}

for label, item in meshes_by_label.items():
    if label not in bone_labels:
        continue

    centroid = np.asarray(item["mesh"].center, dtype=float)
    vector = centroid - center
    vector_length = np.linalg.norm(vector)

    if vector_length == 0:
        directions[label] = np.zeros(3)
    else:
        directions[label] = vector / vector_length

    print(
        f'{item["name"]} centroid: '
        f"x={centroid[0]:.2f}, y={centroid[1]:.2f}, z={centroid[2]:.2f}"
    )

plotter = pv.Plotter(
    lighting="none",
    window_size=(1000, 1000),
    off_screen=True,
)

plotter.set_background("white")
plotter.add_light(pv.Light(light_type="headlight"))

frame_dir = "json_exploding_bones_lungs_frames"
os.makedirs(frame_dir, exist_ok=True)

bone_actors = {}

for label, item in meshes_by_label.items():
    if label in bone_labels:
        actor = plotter.add_mesh(
            item["mesh"].copy(),
            scalars="RGB",
            rgb=True,
            smooth_shading=True,
            opacity=min(item["opacity"], 0.99),
            name=f'{label}: {item["name"]}',
        )
        bone_actors[label] = actor
    else:
        plotter.add_mesh(
            item["mesh"],
            scalars="RGB",
            rgb=True,
            smooth_shading=True,
            opacity=item["opacity"],
            name=f'{label}: {item["name"]}',
        )

n_frames = 250
max_distance = 250.0

radius = max(
    bounds[1] - bounds[0],
    bounds[3] - bounds[2],
    bounds[5] - bounds[4],
) * 2.5

elevation = np.radians(30)

for i in range(n_frames):
    half_frames = n_frames // 2

    if i <= half_frames:
        distance = max_distance * i / half_frames
    else:
        distance = max_distance * (n_frames - i) / half_frames

    normalized_distance = distance / max_distance
    fade = 1.0 - (
        6.0 * normalized_distance**5
        - 15.0 * normalized_distance**4
        + 10.0 * normalized_distance**3
    )
    fade = float(np.clip(fade, 0.0, 0.99))

    for label, actor in bone_actors.items():
        offset = directions[label] * distance
        actor.SetPosition(float(offset[0]), float(offset[1]), float(offset[2]))

        lut_opacity = meshes_by_label[label]["opacity"]
        actor.GetProperty().SetOpacity(float(min(lut_opacity, 0.99) * fade))

    angle = np.radians(90.0 + (i / n_frames) * 360.0)

    x = center[0] + radius * np.cos(angle) * np.cos(elevation)
    y = center[1] + radius * np.sin(angle) * np.cos(elevation)
    z = center[2] + radius * np.sin(elevation)

    plotter.camera.position = (float(x), float(y), float(z))
    plotter.camera.focal_point = tuple(center)
    plotter.camera.up = (0, 0, 1)

    plotter.render()

    frame_path = os.path.join(frame_dir, f"frame_{i:04d}.png")
    plotter.screenshot(frame_path)
    print(f"Saved frame {i + 1}/{n_frames}")

plotter.close()

print("Saved aligned exploding-bones-to-lungs animation frames.")
