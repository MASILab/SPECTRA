import os
import numpy as np
import pyvista as pv
import SimpleITK as sitk

ct_file = "data/ct_scan.nii.gz"

seg_file = "data/segmentation_file.nii.gz"


seg_img = sitk.ReadImage(seg_file)

seg_array = sitk.GetArrayFromImage(seg_img)

spacing = seg_img.GetSpacing()
origin = seg_img.GetOrigin()

organ_labels = {

    (seg_file, 10): "lung_upper_lobe_left",
    (seg_file, 11): "lung_lower_lobe_left",
    (seg_file, 12): "lung_upper_lobe_right",
    (seg_file, 13): "lung_middle_lobe_right",
    (seg_file, 14): "lung_lower_lobe_right",

    (seg_file, 15): "esophagus",

    (seg_file, 16): "trachea",

    (seg_file, 51): "heart",

    (seg_file, 17): "thyroid_gland",
}


colors = {

    "lung_upper_lobe_left": [135, 206, 235],
    "lung_lower_lobe_left": [110, 180, 220],
    "lung_upper_lobe_right": [125, 200, 240],
    "lung_middle_lobe_right": [90, 185, 225],
    "lung_lower_lobe_right": [70, 160, 220],

    "esophagus": [135, 80, 170],

    "trachea": [0, 190, 210],

    "heart": [180, 30, 45],

    "thyroid_gland": [210, 90, 170],
}


models = pv.MultiBlock()
meshes = []
organ_meshes = {}

for (file, label), name in organ_labels.items():

    print(f"Processing {name}")

    if file == seg_file:
        array = seg_array

    mask = (array == label).astype(np.uint8)

    if mask.sum() == 0:
        print(f"  {name} missing")
        continue

    mask = np.transpose(mask, (2, 1, 0))

    grid = pv.ImageData()
    grid.dimensions = np.array(mask.shape) + 1
    grid.spacing = spacing
    grid.origin = origin

    grid.cell_data["mask"] = mask.ravel(order="F")
    grid = grid.cell_data_to_point_data()

    surface = grid.contour(
        isosurfaces=[0.5],
        scalars="mask"
    )

    if surface.n_points == 0:
        print(f"  {name} produced no surface")
        continue

    surface = surface.smooth(
        n_iter=200,
        relaxation_factor=0.05
    )

    rgb = np.tile(
        np.array(colors[name], dtype=np.uint8),
        (surface.n_points, 1)
    )

    surface.point_data["RGB"] = rgb

    models.append(surface)
    meshes.append((name, surface))
    organ_meshes[name] = surface

plotter = pv.Plotter(
    lighting="none",
    window_size=(1000, 1000),
    off_screen=True
)

for name, block in meshes:

    if name in {
        "lung_upper_lobe_left",
        "lung_lower_lobe_left",
        "lung_upper_lobe_right",
        "lung_middle_lobe_right",
        "lung_lower_lobe_right",
    }:
        opacity = 0.5
    else:
        opacity = 1.0

    plotter.add_mesh(
        block,
        scalars="RGB",
        rgb=True,
        smooth_shading=True,
        opacity=opacity
    )

light = pv.Light(light_type="headlight")
plotter.add_light(light)



bounds = models.bounds

center = np.array([
    (bounds[0]+bounds[1])/2,
    (bounds[2]+bounds[3])/2,
    (bounds[4]+bounds[5])/2,
])


radius = max(
    bounds[1]-bounds[0],
    bounds[3]-bounds[2],
    bounds[5]-bounds[4],
) * 2.5


frame_dir = "organ_frames"
os.makedirs(frame_dir, exist_ok=True)


n_frames = 250
elevation = np.radians(30)


for i, angle in enumerate(
    np.linspace(0,360,n_frames,endpoint=False) + 270
):

    theta = np.radians(angle)


    x = center[0] + radius*np.cos(theta)*np.cos(elevation)
    y = center[1] + radius*np.sin(theta)*np.cos(elevation)
    z = center[2] + radius*np.sin(elevation)


    plotter.camera.position = (x,y,z)
    plotter.camera.focal_point = center
    plotter.camera.up = (0,0,1)


    plotter.render()


    plotter.screenshot(
        os.path.join(
            frame_dir,
            f"frame_{i:04d}.png"
        )
    )


plotter.close()

print("Saved organ frames.")
