    115: [222, 205, 170],

    116: [240, 235, 220], # ivory

    117: [190, 240, 240], # pale cyan
}

labels_to_keep = list(bone_labels.keys())

smoothed_model = pv.MultiBlock()

for label in labels_to_keep:

    print(f"Processing label {label}: {bone_labels[label]}")

    mask = (seg_array == label).astype(np.uint8)

    if mask.sum() == 0:
        print("  Label not found.")
        continue

    mask = np.transpose(mask, (2, 1, 0))

    grid = pv.ImageData()

    grid.dimensions = np.array(mask.shape) + 1
    grid.spacing = spacing
    grid.origin = origin

    grid.cell_data["mask"] = mask.ravel(order="F")

    grid = grid.cell_data_to_point_data()

    surface = grid.contour(
        isosurfaces=[0.5],
        scalars="mask",
    )

    if surface.n_points == 0:
        continue

    surface = surface.smooth(
        n_iter=200,
        relaxation_factor=0.05,
    )

    rgb = np.tile(
        np.array(label_colors[label], dtype=np.uint8),
        (surface.n_points, 1),
    )

    surface.point_data["RGB"] = rgb

    smoothed_model.append(surface)

plotter = pv.Plotter(
    lighting="none",
    window_size=(1000, 1000),
    off_screen=True,
)

plotter.add_mesh(
    smoothed_model,
    scalars="RGB",
    rgb=True,
    smooth_shading=True,
)

light = pv.Light(light_type="headlight")
plotter.add_light(light)

bounds = smoothed_model.bounds

center = np.array([
    (bounds[0] + bounds[1]) / 2,
    (bounds[2] + bounds[3]) / 2,
    (bounds[4] + bounds[5]) / 2,
])

radius = max(
    bounds[1] - bounds[0],
    bounds[3] - bounds[2],
) * 3

elevation = np.radians(30)

n_frames = 250
frame_dir = "bone_frames"
os.makedirs(frame_dir, exist_ok=True)

start_angle = 90

for i, azimuth_deg in enumerate(
    np.linspace(start_angle, start_angle + 360, n_frames, endpoint=False)
):

    azimuth = np.radians(azimuth_deg)

    x = center[0] + radius * np.cos(azimuth) * np.cos(elevation)
    y = center[1] + radius * np.sin(azimuth) * np.cos(elevation)
    z = center[2] + radius * np.sin(elevation)

    plotter.camera.position = (x, y, z)
    plotter.camera.focal_point = center
    plotter.camera.up = (0, 0, 1)

    plotter.render()

    plotter.screenshot(
        os.path.join(frame_dir, f"frame_{i:04d}.png")
    )

plotter.close()

print(f"Saved frames to {frame_dir}/")
