    42: [200, 185, 138],
    43: [200, 185, 138],

    92:  [222, 205, 170], # bone tan
    93:  [222, 205, 170],
    94:  [222, 205, 170],
    95:  [222, 205, 170],
    96:  [222, 205, 170],
    97:  [222, 205, 170],
