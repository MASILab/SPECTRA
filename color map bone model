import os
import numpy as np
import pyvista as pv
import SimpleITK as sitk

ct_file = "data/ct_scan.nii.gz"
seg_file = "data/segmentation_file.nii.gz"

ct = sitk.ReadImage(ct_file)
seg = sitk.ReadImage(seg_file)

seg_array = sitk.GetArrayFromImage(seg)

spacing = seg.GetSpacing()
origin = seg.GetOrigin()

bone_labels = {
    32: "vertebrae_T12",
    33: "vertebrae_T11",
    34: "vertebrae_T10",
    35: "vertebrae_T9",
