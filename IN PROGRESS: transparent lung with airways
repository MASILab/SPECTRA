import nibabel as nib
import numpy as np
import pyvista as pv
from skimage import measure

img = nib.load("data/output.nii.gz")
affine = img.affine

seg = nib.load("data/segmentation_file.nii.gz")
seg_data = seg.get_fdata()

print("Unique labels:", np.unique(seg_data))

lung_labels = {
    10: "Left Upper",
    11: "Left Lower",
    12: "Right Upper",
    13: "Right Middle",
    14: "Right Lower",
}

label_colors = {
    10: [255, 182, 193],
    11: [255, 105, 180],
    12: [156, 229, 247],
    13: [84, 170, 235],
    14: [37, 106, 204],
}

multiblock = pv.MultiBlock()

for label, name in lung_labels.items():
    print(f"Processing {name} (label {label})")

    mask = (seg_data == label).astype(np.uint8)

    if np.sum(mask) == 0:
        continue

    verts, faces, _, _ = measure.marching_cubes(mask, level=0.5)

    faces = np.hstack([
        np.full((faces.shape[0], 1), 3),
        faces
    ]).astype(np.int64)

    mesh = pv.PolyData(verts, faces)

    mesh.points = nib.affines.apply_affine(affine, mesh.points)

    color = np.array(label_colors[label], dtype=np.uint8)
    mesh.cell_data["RGB"] = np.tile(color, (mesh.n_cells, 1))

    multiblock[name] = mesh

airway_data = (img.get_fdata() > 0).astype(np.uint8)

verts, faces, _, _ = measure.marching_cubes(
    airway_data,
    level=0.5
)

faces = np.hstack([
    np.full((faces.shape[0], 1), 3),
    faces
]).astype(np.int64)

airway_mesh = pv.PolyData(verts, faces)

airway_mesh.points = nib.affines.apply_affine(
    affine,
    airway_mesh.points
)

plotter = pv.Plotter()
plotter.background_color = "white"

for block in multiblock:
    if block is not None:
        plotter.add_mesh(
            block,
            scalars="RGB",
            rgb=True,
            opacity=0.25,
        )

plotter.add_mesh(
    airway_mesh,
    color="navy",
    opacity=1.0,
)

plotter.add_axes()
plotter.show()
