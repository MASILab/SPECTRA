for name, mesh in original_meshes.items():

    if name in centroids:

        dissolve_values[name] = np.random.random(
            mesh.n_points
        )

for name, mesh in original_meshes.items():

    actor = plotter.add_mesh(
        mesh,
        scalars="RGB",
        rgb=True,
        smooth_shading=True
    )

    actors[name] = actor

