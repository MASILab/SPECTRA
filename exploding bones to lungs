    models
):

    if name not in centroids:

        plotter.add_mesh(
            mesh,
            scalars="RGB",
            rgb=True,
            smooth_shading=True
        )



n_frames = 250

max_distance = 250


radius = max(
    bounds[1]-bounds[0],
    bounds[3]-bounds[2],
    bounds[5]-bounds[4],
) * 2.5


elevation = np.radians(30)


for i in range(n_frames):

    half_frames = n_frames // 2

    if i <= half_frames:

        distance = (
            max_distance *
            (i / half_frames)
        )

    else:

        distance = (
            max_distance *
            ((n_frames - i) / half_frames)
        )


    d = distance / max_distance

    opacity = 1 - (6*d**5 - 15*d**4 + 10*d**3)

    for name, actor in actors.items():

        if name not in centroids:
            continue

        offset = directions[name] * distance

        actor.SetPosition(
            offset[0],
            offset[1],
            offset[2]
        )

        actor.GetProperty().SetOpacity(min(opacity, 0.99))

    angle = np.radians(
        270 + (i/n_frames)*360
    )

    x = (
        center[0]
        +
        radius*np.cos(angle)*np.cos(elevation)
    )

    y = (
        center[1]
        +
        radius*np.sin(angle)*np.cos(elevation)
    )

    z = (
        center[2]
        +
        radius*np.sin(elevation)
    )

    plotter.camera.position = (
        x,
        y,
        z
    )

    plotter.camera.focal_point = center

    plotter.camera.up = (
        0,
        0,
        1
    )

    plotter.render()

    plotter.screenshot(
        os.path.join(
            frame_dir,
            f"frame_{i:04d}.png"
        )
    )

plotter.close()

