import os
import numpy as np
import pyvista as pv

input_file = "output/colored_lungs.vtm"
output_file = "output/lung_spin.vtm"

model = pv.read(input_file)

smoothed_model = pv.MultiBlock()

for i in range(model.n_blocks):

    block = model[i]

    if block is not None:

        print("Processing block:", i)

        smoothed_block = block.smooth(
            n_iter=200,
            relaxation_factor=0.05
        )

        for name in block.point_data.keys():
            smoothed_block.point_data[name] = block.point_data[name]

        for name in block.cell_data.keys():
            smoothed_block.cell_data[name] = block.cell_data[name]

        smoothed_model.append(smoothed_block)


smoothed_model.save(output_file)

print("Saved:", output_file)


plotter = pv.Plotter(
    lighting="none",
    window_size=(1000, 1000),
    off_screen=True
)

plotter.add_mesh(
    smoothed_model,
    scalars="RGB",
    rgb=True,
    smooth_shading=True
)

light = pv.Light(light_type="headlight")
plotter.add_light(light)

plotter.show(auto_close=False)

bounds = smoothed_model.bounds

center = np.array([
    (bounds[0] + bounds[1]) / 2,
    (bounds[2] + bounds[3]) / 2,
    (bounds[4] + bounds[5]) / 2
])

radius = max(
    bounds[1] - bounds[0],
    bounds[3] - bounds[2]
) * 3

elevation = np.radians(30)

n_frames = 250
fps = 24

os.makedirs("frames", exist_ok=True)

start_angle = 270

for i, azimuth_deg in enumerate(
    np.linspace(start_angle, start_angle + 360, n_frames, endpoint=False)
):

    azimuth = np.radians(azimuth_deg)

    x = center[0] + radius * np.cos(azimuth) * np.cos(elevation)
    y = center[1] + radius * np.sin(azimuth) * np.cos(elevation)
    z = center[2] + radius * np.sin(elevation)

    plotter.camera.position = (x, y, z)
    plotter.camera.focal_point = center
    plotter.camera.up = (0, 0, 1)

    plotter.render()

    plotter.screenshot(
        f"frames/frame_{i:04d}.png"
    )

plotter.close()

print("Saved frames to frames/")
