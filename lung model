import nibabel as nib
import numpy as np
from skimage import measure
import pyvista as pv
import os

# -------------------------
# 1. Setup output folder
# -------------------------
os.makedirs("output", exist_ok=True)

# -------------------------
# 2. Load segmentation file
# -------------------------
seg = nib.load("data/segmentation_file.nii.gz")
seg_data = seg.get_fdata()

print("Unique labels:", np.unique(seg_data))

# -------------------------
# 3. Lung lobe labels and names
# -------------------------
lung_labels = {
    10: "Left Upper",
    11: "Left Lower",
    12: "Right Upper",
    13: "Right Middle",
    14: "Right Lower",
}

# -------------------------
# 4. Fixed RGB color map (cross-program safe)
# -------------------------
label_colors = {
    10: [255, 182, 193],  # light pink
    11: [255, 105, 180],  # hot pink
    12: [156, 229, 247],  # teal
    13: [84, 170, 235],   # light blue
    14: [37, 106, 204],   # dark blue
}

# -------------------------
# 5. Create MultiBlock dataset
# -------------------------
multiblock = pv.MultiBlock()

# -------------------------
# 6. Build meshes
# -------------------------
for label, name in lung_labels.items():
    print(f"Processing {name} (label {label})")

    mask = (seg_data == label).astype(np.uint8)

    if np.sum(mask) == 0:
        print(f"{name} is empty, skipping.")
        continue

    verts, faces, _, _ = measure.marching_cubes(mask, level=0.5)

    faces_pv = np.hstack([
        np.full((faces.shape[0], 1), 3),
        faces
    ]).astype(np.int64)

    mesh = pv.PolyData(verts, faces_pv)

    # Store label (optional)
    mesh.cell_data["label"] = np.full(mesh.n_cells, label)

    # -------------------------
    # Add RGB colors
    # -------------------------
    color = np.array(label_colors[label], dtype=np.uint8)
    mesh.cell_data["RGB"] = np.tile(color, (mesh.n_cells, 1))

    multiblock[name] = mesh

# -------------------------
# 7. Save file (optional but useful)
# -------------------------
output_file = "output/colored_lungs.vtm"
multiblock.save(output_file)

print(f"Saved: {output_file}")

# -------------------------
# 8. INTERACTIVE PLOTTING WINDOW
# -------------------------
print("Opening interactive PyVista window...")
plotter = pv.Plotter()
plotter.background_color = "white"

for block in multiblock:
    if block is not None:
        plotter.add_mesh(block, scalars="RGB", rgb=True)

plotter.add_axes()
plotter.show()
