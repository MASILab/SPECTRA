import pyvista as pv

input_file = "output/colored_lungs_airways.vtm"
output_file = "output/colored_lungs_airways_smoothed.vtm"


model = pv.read(input_file)

print("Original blocks:", list(model.keys()))


smoothed_model = pv.MultiBlock()


for i, name in enumerate(model.keys()):

    block = model[i]

    if block is None:
        continue

    print(f"Processing {name}")

    smoothed_block = block.smooth(
        n_iter=200,
        relaxation_factor=0.05
    )


    for array_name in block.point_data.keys():
        smoothed_block.point_data[array_name] = block.point_data[array_name]


    for array_name in block.cell_data.keys():
        smoothed_block.cell_data[array_name] = block.cell_data[array_name]


    smoothed_model[name] = smoothed_block



smoothed_model.save(output_file)

print("Saved:", output_file)



plotter = pv.Plotter()

plotter.background_color = "white"


for name, block in zip(smoothed_model.keys(), smoothed_model):

    if block is None:
        continue


    if name in [
        "Left Upper",
        "Left Lower",
        "Right Upper",
        "Right Middle",
        "Right Lower"
    ]:
        opacity = 0.1

    elif name == "Airways":
        opacity = 0.35

    elif name == "Airway Wall":
        opacity = 0.0

    else:
        opacity = 1.0


    plotter.add_mesh(
        block,
        scalars="RGB",
        rgb=True,
        opacity=opacity
    )


plotter.add_axes()

plotter.show()
