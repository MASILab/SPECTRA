import os
import numpy as np
import pyvista as pv
import SimpleITK as sitk

vessel_file = "data/vessels.nii.gz"
seg_file = "data/segmentation_file.nii.gz"

vessel_img = sitk.ReadImage(vessel_file)
seg_img = sitk.ReadImage(seg_file)

vessel_array = sitk.GetArrayFromImage(vessel_img)
seg_array = sitk.GetArrayFromImage(seg_img)

spacing = vessel_img.GetSpacing()
origin = vessel_img.GetOrigin()

structure_labels = {
    (seg_file, 10): "lung_upper_lobe_left",
    (seg_file, 11): "lung_lower_lobe_left",
    (seg_file, 12): "lung_upper_lobe_right",
    (seg_file, 13): "lung_middle_lobe_right",
    (seg_file, 14): "lung_lower_lobe_right",

    (seg_file, 52): "aorta",
    (seg_file, 53): "pulmonary_vein",
    (seg_file, 54): "brachiocephalic_trunk",
    (seg_file, 55): "subclavian_artery_right",
    (seg_file, 56): "subclavian_artery_left",
    (seg_file, 57): "common_carotid_artery_right",
    (seg_file, 58): "common_carotid_artery_left",
    (seg_file, 59): "brachiocephalic_vein_left",
    (seg_file, 60): "brachiocephalic_vein_right",
    (seg_file, 62): "superior_vena_cava",
    (seg_file, 63): "inferior_vena_cava",

    (vessel_file, 44): "heart_myocardium",
    (vessel_file, 45): "heart_atrium_left",
    (vessel_file, 46): "heart_ventricle_left",
    (vessel_file, 47): "heart_atrium_right",
    (vessel_file, 48): "heart_ventricle_right",
    (vessel_file, 49): "pulmonary_artery",
}

colors = {
    "lung_upper_lobe_left": [159,223,250],
    "lung_lower_lobe_left": [80,200,255],
    "lung_upper_lobe_right": [120,170,255],
    "lung_middle_lobe_right": [40,130,220],
    "lung_lower_lobe_right": [10,70,170],

    "heart_myocardium": [180, 30, 45],
    "heart_atrium_left": [165, 55, 80],
    "heart_ventricle_left": [150, 15, 35],
    "heart_atrium_right": [195, 65, 85],
    "heart_ventricle_right": [205, 45, 60],

    "aorta": [220, 20, 60],

    "pulmonary_artery": [230, 80, 50],
    "pulmonary_vein": [205, 70, 90],

    "brachiocephalic_trunk": [215, 55, 55],

    "subclavian_artery_right": [210, 45, 45],
    "subclavian_artery_left": [210, 45, 45],

    "common_carotid_artery_right": [225, 45, 45],
    "common_carotid_artery_left": [225, 45, 45],

    "brachiocephalic_vein_left": [90, 140, 220],
    "brachiocephalic_vein_right": [90, 140, 220],

    "superior_vena_cava": [45, 95, 190],
    "inferior_vena_cava": [30, 75, 170],
}

opacities = {
    "heart_myocardium": 0.8,
    "heart_atrium_left": 0.8,
    "heart_ventricle_left": 0.8,
    "heart_atrium_right": 0.8,
    "heart_ventricle_right": 0.8,
}

centroids = {
    "lung_upper_lobe_left":
        np.array([79.38,546.64,22.51]),
    "lung_lower_lobe_left":
        np.array([79.01,498.79,-40.45]),
    "lung_upper_lobe_right":
        np.array([-64.43,548.49,46.06]),
    "lung_middle_lobe_right":
        np.array([-61.65,589.82,-39.87]),
    "lung_lower_lobe_right":
        np.array([-75.32,521.02,-45.13]),
}

models = pv.MultiBlock()

for (file,label), name in structure_labels.items():

    print("Processing", name)

    if file == vessel_file:
        array = vessel_array
    else:
        array = seg_array

    mask = (array == label).astype(np.uint8)

    if mask.sum() == 0:
        print("missing")
        continue

    mask = np.transpose(mask,(2,1,0))

    grid = pv.ImageData()

    grid.dimensions = np.array(mask.shape)+1
    grid.spacing = spacing
    grid.origin = origin

    grid.cell_data["mask"] = mask.ravel(order="F")

    grid = grid.cell_data_to_point_data()

    surface = grid.contour(
        isosurfaces=[0.5],
        scalars="mask"
    )

    if surface.n_points == 0:
        continue

    surface = surface.smooth(
        n_iter=200,
        relaxation_factor=0.05
    )

    rgb = np.tile(
        np.array(colors[name],dtype=np.uint8),
        (surface.n_points,1)
    )

    surface.point_data["RGB"] = rgb

    models.append(surface)

bounds = models.bounds

center = np.array([

    (bounds[0]+bounds[1])/2,
    (bounds[2]+bounds[3])/2,
    (bounds[4]+bounds[5])/2

])

print("Scene center:",center)

directions = {}

for name,c in centroids.items():

    vec = c-center

    vec = vec / np.linalg.norm(vec)

    directions[name] = vec

original_meshes = {}

for name,mesh in zip(structure_labels.values(),models):

    if name in centroids:

        original_meshes[name] = mesh.copy()

plotter = pv.Plotter(
    lighting="none",
    window_size=(1000,1000),
    off_screen=True
)

light = pv.Light(
    light_type="headlight"
)

plotter.add_light(light)

frame_dir="exploding_lungs_to_vessels_frames"

os.makedirs(
    frame_dir,
    exist_ok=True
)

actors = {}

dissolve_values = {}

for name, mesh in original_meshes.items():

    if name in centroids:

        dissolve_values[name] = np.random.random(
            mesh.n_points
        )

for name, mesh in original_meshes.items():

    actor = plotter.add_mesh(
        mesh,
        scalars="RGB",
        rgb=True,
        smooth_shading=True
    )

    actors[name] = actor

dissolve_masks = {}


for name, mesh in zip(
    structure_labels.values(),
    models
):

    if name not in centroids:

        plotter.add_mesh(
            mesh,
            scalars="RGB",
            rgb=True,
            smooth_shading=True,
            opacity=opacities.get(name,1.0)
   )



n_frames = 250

max_distance = 250


radius = max(
    bounds[1]-bounds[0],
    bounds[3]-bounds[2],
    bounds[5]-bounds[4],
) * 2.5


elevation = np.radians(30)


for i in range(n_frames):

    half_frames = n_frames // 2

    if i <= half_frames:

        distance = (
            max_distance *
            (i / half_frames)
        )

    else:

        distance = (
            max_distance *
            ((n_frames - i) / half_frames)
        )


    d = distance / max_distance

    opacity = 1 - (6*d**5 - 15*d**4 + 10*d**3)

    for name, actor in actors.items():

        if name not in centroids:
            continue

        offset = directions[name] * distance

        actor.SetPosition(
            offset[0],
            offset[1],
            offset[2]
        )

        actor.GetProperty().SetOpacity(min(opacity, 0.99))

    angle = np.radians(
        270 + (i/n_frames)*360
    )

    x = (
        center[0]
        +
        radius*np.cos(angle)*np.cos(elevation)
    )

    y = (
        center[1]
        +
        radius*np.sin(angle)*np.cos(elevation)
    )

    z = (
        center[2]
        +
        radius*np.sin(elevation)
    )

    plotter.camera.position = (
        x,
        y,
        z
    )

    plotter.camera.focal_point = center

    plotter.camera.up = (
        0,
        0,
        1
    )

    plotter.render()

    plotter.screenshot(
        os.path.join(
            frame_dir,
            f"frame_{i:04d}.png"
        )
    )

plotter.close()

print("Saved exploded lung-to-vessel animation frames.")
