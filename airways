import nibabel as nib
import numpy as np
from skimage import measure
import pyvista as pv
import os

os.makedirs("output", exist_ok=True)

img = nib.load("data/output.nii.gz")
data = img.get_fdata()

spacing = np.array(img.header.get_zooms()[:3])

print("Voxel spacing (x, y, z):", spacing)
print("Unique labels:", np.unique(data))

airway_labels = {
    1: "Airways",
    2: "Airway Wall",
}

label_colors = {
    1: [204, 255, 255],   # aqua
    2: [0, 76, 153],      # gray blue
}

multiblock = pv.MultiBlock()

for label, name in airway_labels.items():

    print(f"Processing {name} (label {label})")

    mask = (data == label).astype(np.uint8)

    if np.sum(mask) == 0:
        print(f"{name} is empty, skipping.")
        continue

    verts, faces, _, _ = measure.marching_cubes(
        mask,
        level=0.5,
        spacing=spacing
    )

    faces_pv = np.hstack((
        np.full((faces.shape[0], 1), 3),
        faces
    )).astype(np.int64)

    mesh = pv.PolyData(verts, faces_pv)

    mesh.cell_data["label"] = np.full(mesh.n_cells, label)

    color = np.array(label_colors[label], dtype=np.uint8)
    mesh.cell_data["RGB"] = np.tile(color, (mesh.n_cells, 1))

    multiblock[name] = mesh

output_file = "output/colored_airways.vtm"
multiblock.save(output_file)

print(f"Saved: {output_file}")

print("Opening interactive PyVista window...")

plotter = pv.Plotter()
plotter.background_color = "white"

for name, block in zip(multiblock.keys(), multiblock):
    if block is not None:

        if name == "Airways":
            opacity = 0.15
        else:
            opacity = 1.0

        plotter.add_mesh(
            block,
            scalars="RGB",
            rgb=True,
            opacity=opacity
        )

plotter.add_axes()
plotter.show()
