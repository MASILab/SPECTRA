import json
import os

import numpy as np
import pyvista as pv
import SimpleITK as sitk


vessel_file = "data/vessels.nii.gz"
seg_file = "data/segmentation_file.nii.gz"
lut_file = "data/lut.json"


labels_to_keep = [
    10,
    11,
    12,
    13,
    14,

    44,
    45,
    46,
    47,
    48,
    49,

    52,
    53,
    54,
    55,
    56,
    57,
    58,
    59,
    60,
    62,
    63,
]


vessel_file_labels = {
    44,
    45,
    46,
    47,
    48,
    49,
}


exploding_labels = {
    10,
    11,
    12,
    13,
    14,
}


centroids = {
    10: np.array([79.38, 546.64, 22.51]),
    11: np.array([79.01, 498.79, -40.45]),
    12: np.array([-64.43, 548.49, 46.06]),
    13: np.array([-61.65, 589.82, -39.87]),
    14: np.array([-75.32, 521.02, -45.13]),
}


vessel_img = sitk.ReadImage(vessel_file)
seg_img = sitk.ReadImage(seg_file)

image_data = {
    vessel_file: {
        "array": sitk.GetArrayFromImage(vessel_img),
        "spacing": vessel_img.GetSpacing(),
        "origin": vessel_img.GetOrigin(),
    },
    seg_file: {
        "array": sitk.GetArrayFromImage(seg_img),
        "spacing": seg_img.GetSpacing(),
        "origin": seg_img.GetOrigin(),
    },
}


with open(lut_file, "r", encoding="utf-8") as f:
    lut = json.load(f)


def get_lut_entry(label):
    """
    Read and validate the structure name, RGB color,
    and opacity for a segmentation label.
    """

    entry = lut.get(str(label))

    if entry is None:
        raise KeyError(
            f"Label {label} is missing from {lut_file}"
        )

    structure_name = entry.get(
        "structure",
        f"Label {label}",
    )

    rgb = entry.get("rgb")

    if (
        not isinstance(rgb, list)
        or len(rgb) != 3
        or any(
            not isinstance(value, (int, float))
            for value in rgb
        )
        or any(value < 0 or value > 255 for value in rgb)
    ):
        raise ValueError(
            f"Label {label} has an invalid RGB value: {rgb!r}"
        )

    opacity = float(entry.get("opacity", 1.0))

    if not 0.0 <= opacity <= 1.0:
        raise ValueError(
            f"Label {label} has invalid opacity: {opacity}"
        )

    color = np.asarray(rgb, dtype=np.uint8)

    return structure_name, color, opacity


structures = []

for label in labels_to_keep:

    if label in vessel_file_labels:
        source_file = vessel_file
    else:
        source_file = seg_file

    name, color, opacity = get_lut_entry(label)

    print(f"Processing label {label}: {name}")

    source = image_data[source_file]

    array = source["array"]
    spacing = source["spacing"]
    origin = source["origin"]

    mask = (array == label).astype(np.uint8)

    if mask.sum() == 0:
        print(f"  Label not found in {source_file}.")
        continue

    mask = np.transpose(mask, (2, 1, 0))

    grid = pv.ImageData()
    grid.dimensions = np.asarray(mask.shape) + 1
    grid.spacing = spacing
    grid.origin = origin

    grid.cell_data["mask"] = mask.ravel(order="F")
    grid = grid.cell_data_to_point_data()

    surface = grid.contour(
        isosurfaces=[0.5],
        scalars="mask",
    )

    if surface.n_points == 0:
        print("  No surface could be generated.")
        continue

    surface = surface.smooth(
        n_iter=200,
        relaxation_factor=0.05,
    )

    surface.point_data["RGB"] = np.tile(
        color,
        (surface.n_points, 1),
    )

    structures.append(
        {
            "label": label,
            "name": name,
            "opacity": opacity,
            "surface": surface,
        }
    )


if not structures:
    raise RuntimeError(
        "None of the labels in labels_to_keep were found."
    )


models = pv.MultiBlock()

for item in structures:
    models.append(item["surface"])

bounds = np.asarray(models.bounds)

center = np.array(
    [
        (bounds[0] + bounds[1]) / 2,
        (bounds[2] + bounds[3]) / 2,
        (bounds[4] + bounds[5]) / 2,
    ]
)

print("Scene center:", center)


directions = {}

for label, centroid in centroids.items():

    if label not in exploding_labels:
        continue

    direction = centroid - center
    magnitude = np.linalg.norm(direction)

    if magnitude == 0:
        raise ValueError(
            f"Centroid for label {label} is equal to the scene center."
        )

    directions[label] = direction / magnitude


plotter = pv.Plotter(
    lighting="none",
    window_size=(1000, 1000),
    off_screen=True,
)

light = pv.Light(light_type="headlight")
plotter.add_light(light)


actors = {}

for item in structures:

    label = item["label"]
    name = item["name"]
    mesh = item["surface"]
    lut_opacity = item["opacity"]

    actor = plotter.add_mesh(
        mesh,
        scalars="RGB",
        rgb=True,
        smooth_shading=True,
        opacity=lut_opacity,
        name=f"{label}: {name}",
    )

    if label in exploding_labels:
        actors[label] = {
            "actor": actor,
            "name": name,
            "lut_opacity": lut_opacity,
        }


missing_exploding_labels = exploding_labels.difference(actors)

if missing_exploding_labels:
    print(
        "Warning: these exploding labels were not found:",
        sorted(missing_exploding_labels),
    )


frame_dir = "json_exploding_lungs_vessels_frames"
os.makedirs(frame_dir, exist_ok=True)

n_frames = 250
max_distance = 250

radius = max(
    bounds[1] - bounds[0],
    bounds[3] - bounds[2],
    bounds[5] - bounds[4],
) * 2.5

elevation = np.radians(30)


for i in range(n_frames):

    half_frames = n_frames // 2

    if i <= half_frames:
        distance = max_distance * (i / half_frames)
    else:
        distance = max_distance * (
            (n_frames - i) / half_frames
        )

    progress = distance / max_distance

    fade_opacity = 1 - (
        6 * progress**5
        - 15 * progress**4
        + 10 * progress**3
    )

    for label, actor_data in actors.items():

        if label not in directions:
            continue

        actor = actor_data["actor"]
        lut_opacity = actor_data["lut_opacity"]

        offset = directions[label] * distance

        actor.SetPosition(
            offset[0],
            offset[1],
            offset[2],
        )

        final_opacity = lut_opacity * fade_opacity

        actor.GetProperty().SetOpacity(
            min(final_opacity, 0.99)
        )

    angle = np.radians(
        270 + (i / n_frames) * 360
    )

    x = (
        center[0]
        + radius
        * np.cos(angle)
        * np.cos(elevation)
    )

    y = (
        center[1]
        + radius
        * np.sin(angle)
        * np.cos(elevation)
    )

    z = (
        center[2]
        + radius
        * np.sin(elevation)
    )

    plotter.camera.position = (x, y, z)
    plotter.camera.focal_point = center
    plotter.camera.up = (0, 0, 1)

    plotter.render()

    plotter.screenshot(
        os.path.join(
            frame_dir,
            f"frame_{i:04d}.png",
        )
    )


plotter.close()

print(
    f"Saved exploded lung-to-vessel animation frames "
    f"to {frame_dir}/"
)
