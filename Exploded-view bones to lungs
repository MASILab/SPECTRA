colors = {
    "vertebrae_T12": [200, 185, 138],
    "vertebrae_T11": [200, 185, 138],
    "vertebrae_T10": [200, 185, 138],
    "vertebrae_T9": [200, 185, 138],
    "vertebrae_T8": [200, 185, 138],
    "vertebrae_T7": [200, 185, 138],
    "vertebrae_T6": [200, 185, 138],
    "vertebrae_T5": [200, 185, 138],
    "vertebrae_T4": [200, 185, 138],
    "vertebrae_T3": [200, 185, 138],
    "vertebrae_T2": [200, 185, 138],
    "vertebrae_T1": [200, 185, 138],

    "rib_left_1": [222, 205, 170],
    "rib_left_2": [222, 205, 170],
    "rib_left_3": [222, 205, 170],
