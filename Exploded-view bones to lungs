    "rib_right_12": [222, 205, 170],

    "sternum": [240, 235, 220],
    "costal_cartilages": [190, 240, 240],

    "lung_upper_lobe_left": [159, 223, 250],
    "lung_lower_lobe_left": [80, 200, 255],
    "lung_upper_lobe_right": [120, 170, 255],
    "lung_middle_lobe_right": [40, 130, 220],
    "lung_lower_lobe_right": [10, 70, 170],
    "trachea": [0, 190, 210],
}


bone_names = {
    name
    for label, name in structure_labels.items()
    if (
        32 <= label <= 43
        or 92 <= label <= 117
    )
}


meshes_by_name = {}

for label, name in structure_labels.items():

    print("Processing", name)

    mask_zyx = (seg_array == label).astype(np.uint8)

    if mask_zyx.sum() == 0:
        print("  missing")
        continue

    mask_xyz = np.transpose(mask_zyx, (2, 1, 0))

    grid = pv.ImageData()

    grid.dimensions = np.array(mask_xyz.shape) + 1
    grid.spacing = spacing
    grid.origin = origin

    grid.direction_matrix = direction_matrix

    grid.cell_data["mask"] = mask_xyz.ravel(order="F")

    grid = grid.cell_data_to_point_data()

    surface = grid.contour(
        isosurfaces=[0.5],
        scalars="mask"
    )

    if surface.n_points == 0:
        print("  empty surface")
        continue

    surface = surface.smooth(
        n_iter=200,
        relaxation_factor=0.05
    )

    rgb = np.tile(
        np.array(colors[name], dtype=np.uint8),
        (surface.n_points, 1)
    )

    surface.point_data["RGB"] = rgb

    meshes_by_name[name] = surface

    print("  points:", surface.n_points)


if not meshes_by_name:
    raise RuntimeError(
        "No meshes were generated. Check the segmentation path and labels."
    )


models = pv.MultiBlock()

for mesh in meshes_by_name.values():
    models.append(mesh)

bounds = models.bounds

center = np.array([
    (bounds[0] + bounds[1]) / 2.0,
    (bounds[2] + bounds[3]) / 2.0,
    (bounds[4] + bounds[5]) / 2.0,
])

print("Scene center:", center)


centroids = {}

for name, mesh in meshes_by_name.items():

    if name in bone_names:
        centroids[name] = np.array(mesh.center, dtype=float)

        print(
            f"{name} centroid: "
            f"x={centroids[name][0]:.2f}, "
            f"y={centroids[name][1]:.2f}, "
            f"z={centroids[name][2]:.2f}"
        )


directions = {}

for name, centroid in centroids.items():

    vector = centroid - center
    vector_length = np.linalg.norm(vector)

    if vector_length == 0:
        directions[name] = np.zeros(3)
    else:
        directions[name] = vector / vector_length


plotter = pv.Plotter(
    lighting="none",
    window_size=(1000, 1000),
    off_screen=True
)

plotter.set_background("white")

light = pv.Light(
    light_type="headlight"
)

plotter.add_light(light)


frame_dir = "exploding_bones_to_lungs_frames"

os.makedirs(
    frame_dir,
    exist_ok=True
)


bone_actors = {}

for name, mesh in meshes_by_name.items():

    if name in bone_names:

        actor = plotter.add_mesh(
            mesh.copy(),
            scalars="RGB",
            rgb=True,
            smooth_shading=True,
            opacity=0.99
        )

        bone_actors[name] = actor

    else:

        plotter.add_mesh(
            mesh,
            scalars="RGB",
            rgb=True,
            smooth_shading=True,
            opacity=1.0
        )


n_frames = 250
max_distance = 250.0

radius = max(
    bounds[1] - bounds[0],
    bounds[3] - bounds[2],
    bounds[5] - bounds[4],
) * 2.5

elevation = np.radians(30)


for i in range(n_frames):

    half_frames = n_frames // 2

    if i <= half_frames:

        distance = (
            max_distance
            * i
            / half_frames
        )

    else:

        distance = (
            max_distance
            * (n_frames - i)
            / half_frames
        )

    normalized_distance = distance / max_distance

    opacity = 1.0 - (
        6.0 * normalized_distance**5
        - 15.0 * normalized_distance**4
        + 10.0 * normalized_distance**3
    )

    opacity = np.clip(opacity, 0.0, 0.99)

    for name, actor in bone_actors.items():

        offset = directions[name] * distance

        actor.SetPosition(
            float(offset[0]),
            float(offset[1]),
            float(offset[2])
        )

        actor.GetProperty().SetOpacity(
            float(opacity)
        )

    angle = np.radians(
        90.0 + (i / n_frames) * 360.0
    )

    x = (
        center[0]
        + radius
        * np.cos(angle)
        * np.cos(elevation)
    )

    y = (
        center[1]
        + radius
        * np.sin(angle)
        * np.cos(elevation)
    )

    z = (
        center[2]
        + radius
        * np.sin(elevation)
    )

    plotter.camera.position = (
        float(x),
        float(y),
        float(z)
    )

    plotter.camera.focal_point = tuple(center)

    plotter.camera.up = (
        0,
        0,
        1
    )

    plotter.render()

    frame_path = os.path.join(
        frame_dir,
        f"frame_{i:04d}.png"
    )

    plotter.screenshot(frame_path)

    print(f"Saved frame {i + 1}/{n_frames}")


plotter.close()

print("Saved aligned exploding-bones-to-lungs animation frames.")
