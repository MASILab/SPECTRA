import os
import numpy as np
import pyvista as pv
import SimpleITK as sitk


seg_file = "data/segmentation_file.nii.gz"

seg_img = sitk.ReadImage(seg_file)
seg_array = sitk.GetArrayFromImage(seg_img)

spacing = np.array(seg_img.GetSpacing(), dtype=float)
origin = np.array(seg_img.GetOrigin(), dtype=float)

direction_matrix = np.array(
    seg_img.GetDirection(),
    dtype=float
).reshape(3, 3)


