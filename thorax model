import nibabel as nib
import numpy as np
from skimage import measure
import pyvista as pv
import os

os.makedirs("output", exist_ok=True)

seg_img = nib.load("data/segmentation_file.nii.gz")
seg_data = seg_img.get_fdata()
seg_affine = seg_img.affine

airway_img = nib.load("data/output.nii.gz")
airway_data = airway_img.get_fdata()
airway_affine = airway_img.affine

print("Segmentation labels:", np.unique(seg_data))
print("Airway labels:", np.unique(airway_data))

lung_heart_structures = {
    10: "Left Upper",
    11: "Left Lower",
    12: "Right Upper",
    13: "Right Middle",
    14: "Right Lower",

    51: "Heart",
    53: "Pulmonary Vein",
}

airway_structures = {
    1: "Airways",
    2: "Airway Wall",
}

label_colors = {

    10: [255, 182, 193],
    11: [255, 105, 180],
    12: [156, 229, 247],
    13: [84, 170, 235],
    14: [37, 106, 204],

    51: [255, 0, 0],
    53: [102, 0, 102],

    1: [0, 76, 153],
    2: [0, 76, 153],
}

def create_mesh(data, affine, label, color):

    mask = (data == label).astype(np.uint8)

    if mask.sum() == 0:
        return None

    print(f"Creating mesh for label {label} ({mask.sum()} voxels)")

    verts, faces, _, _ = measure.marching_cubes(
        mask,
        level=0.5
    )

    verts = nib.affines.apply_affine(
        affine,
        verts
    )

    faces_pv = np.hstack([
        np.full((faces.shape[0], 1), 3),
        faces
    ]).astype(np.int64)

    mesh = pv.PolyData(
        verts,
        faces_pv
    )

    mesh.cell_data["label"] = np.full(mesh.n_cells, label)

    rgb = np.array(color, dtype=np.uint8)
    mesh.cell_data["RGB"] = np.tile(rgb, (mesh.n_cells, 1))

    return mesh

multiblock = pv.MultiBlock()

for label, name in lung_heart_structures.items():

    print(f"Processing {name}")

    mesh = create_mesh(
        seg_data,
        seg_affine,
        label,
        label_colors[label]
    )

    if mesh is not None:
        multiblock[name] = mesh
    else:
        print(f"{name} empty")

for label, name in airway_structures.items():

    print(f"Processing {name}")

    mesh = create_mesh(
        airway_data,
        airway_affine,
        label,
        label_colors[label]
    )

    if mesh is not None:
        multiblock[name] = mesh
    else:
        print(f"{name} empty")

output_file = "output/thorax.vtm"
multiblock.save(output_file)

print(f"Saved: {output_file}")

plotter = pv.Plotter()
plotter.background_color = "white"

for name in multiblock.keys():

    block = multiblock[name]

    if block is None:
        continue

    if name in [
        "Left Upper",
        "Left Lower",
        "Right Upper",
        "Right Middle",
        "Right Lower"
    ]:
        opacity = 0.10

    elif name == "Airways":
        opacity = 0.15

    elif name == "Airway Wall":
        opacity = 1.0

    else:
        opacity = 1.0

    plotter.add_mesh(
        block,
        scalars="RGB",
        rgb=True,
        opacity=opacity
    )

plotter.add_axes()
plotter.show()
