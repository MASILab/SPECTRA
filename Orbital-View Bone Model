import json
import os

import numpy as np
import pyvista as pv
import SimpleITK as sitk


ct_file = "data/ct_scan.nii.gz"
seg_file = "data/segmentation_file.nii.gz"
lut_file = "data/lut.json"

labels_to_keep = list(range(32, 44)) + list(range(92, 118))

ct = sitk.ReadImage(ct_file)
seg = sitk.ReadImage(seg_file)

seg_array = sitk.GetArrayFromImage(seg)
spacing = seg.GetSpacing()
origin = seg.GetOrigin()

with open(lut_file, "r", encoding="utf-8") as f:
    lut = json.load(f)


def get_lut_entry(label):
    """Return and validate the LUT entry for an integer segmentation label."""
    entry = lut.get(str(label))
    if entry is None:
        raise KeyError(f"Label {label} is missing from {lut_file}")

    rgb = entry.get("rgb")
    if (
        not isinstance(rgb, list)
        or len(rgb) != 3
        or any(not isinstance(value, (int, float)) for value in rgb)
        or any(value < 0 or value > 255 for value in rgb)
    ):
        raise ValueError(f"Label {label} has an invalid RGB value: {rgb!r}")

    opacity = float(entry.get("opacity", 1.0))
    if not 0.0 <= opacity <= 1.0:
        raise ValueError(f"Label {label} has invalid opacity: {opacity}")

    return entry, np.asarray(rgb, dtype=np.uint8), opacity


surfaces = []

for label in labels_to_keep:
    entry, color, opacity = get_lut_entry(label)
    structure_name = entry.get("structure", f"Label {label}")

    print(f"Processing label {label}: {structure_name}")

    mask = (seg_array == label).astype(np.uint8)

    if mask.sum() == 0:
        print("  Label not found in segmentation.")
        continue

    mask = np.transpose(mask, (2, 1, 0))

    grid = pv.ImageData()
    grid.dimensions = np.asarray(mask.shape) + 1
    grid.spacing = spacing
    grid.origin = origin
    grid.cell_data["mask"] = mask.ravel(order="F")
    grid = grid.cell_data_to_point_data()

    surface = grid.contour(isosurfaces=[0.5], scalars="mask")

    if surface.n_points == 0:
        print("  No surface could be generated.")
        continue

    surface = surface.smooth(n_iter=200, relaxation_factor=0.05)
    surface.point_data["RGB"] = np.tile(color, (surface.n_points, 1))

    surfaces.append(
        {
            "label": label,
            "name": structure_name,
            "opacity": opacity,
            "surface": surface,
        }
    )

if not surfaces:
    raise RuntimeError("None of the requested LUT labels were found in the segmentation.")

plotter = pv.Plotter(
    lighting="none",
    window_size=(1000, 1000),
    off_screen=True,
)

for item in surfaces:
    plotter.add_mesh(
        item["surface"],
        scalars="RGB",
        rgb=True,
        opacity=item["opacity"],
        smooth_shading=True,
        name=f'{item["label"]}: {item["name"]}',
    )

light = pv.Light(light_type="headlight")
plotter.add_light(light)

bounds = np.asarray(plotter.bounds)
center = np.array(
    [
        (bounds[0] + bounds[1]) / 2,
        (bounds[2] + bounds[3]) / 2,
        (bounds[4] + bounds[5]) / 2,
    ]
)

radius = max(bounds[1] - bounds[0], bounds[3] - bounds[2]) * 3
elevation = np.radians(30)

n_frames = 250
frame_dir = "json_bone_frames"
os.makedirs(frame_dir, exist_ok=True)

start_angle = 90

for i, azimuth_deg in enumerate(
    np.linspace(start_angle, start_angle + 360, n_frames, endpoint=False)
):
    azimuth = np.radians(azimuth_deg)

    x = center[0] + radius * np.cos(azimuth) * np.cos(elevation)
    y = center[1] + radius * np.sin(azimuth) * np.cos(elevation)
    z = center[2] + radius * np.sin(elevation)

    plotter.camera.position = (x, y, z)
    plotter.camera.focal_point = center
    plotter.camera.up = (0, 0, 1)

    plotter.render()
    plotter.screenshot(os.path.join(frame_dir, f"frame_{i:04d}.png"))

plotter.close()

print(f"Saved frames to {frame_dir}/")
